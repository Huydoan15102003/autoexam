# Supabase project URL (Project Settings > API)
SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), server-only here; RLS protects data
SUPABASE_PUBLISHABLE_KEY=
# Public site URL, fallback for email confirmation links (e.g. https://autoexam.vercel.app)
SITE_URL=
# Azure Speech resource key (pronunciation assessment), server-only
AZURE_SPEECH_KEY=
# Azure Speech region, e.g. southeastasia
AZURE_SPEECH_REGION=
# OpenAI API key (content scoring), server-only
OPENAI_API_KEY=
# OpenAI model used for content scoring
OPENAI_MODEL=gpt-5-mini
# Max assessed recordings / essays per user per 24 h (cost guard for the public URL)
SPEAKING_DAILY_LIMIT=30
WRITING_DAILY_LIMIT=30
